{
  "name": "shiploop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ShipLoop engineering workspace (private, not published; local pack only)",
  "engines": {
    "node": "22.19.0",
    "npm": "10.9.3"
  },
  "os": [
    "darwin"
  ],
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "packages/core",
    "packages/host",
    "packages/cli"
  ],
  "scripts": {
    "test": "node scripts/run-tests.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "build": "node scripts/build-host-lock.ts && tsc -b packages/core/tsconfig.json packages/host/tsconfig.json packages/cli/tsconfig.json && node scripts/prepare-cli-bin.ts && node scripts/smoke-built-entries.ts",
    "pack:local": "node scripts/pack-local.ts",
    "verify:artifacts": "node scripts/verify-artifacts.ts",
    "verify:ci-config": "node scripts/verify-ci-config.ts",
    "verify": "node scripts/verify.ts",
    "accept:p01": "node scripts/acceptance/p01-accept.ts",
    "accept:p02": "node scripts/acceptance/p02-accept.ts",
    "accept:p03": "node scripts/acceptance/p03-accept.ts",
    "accept:p04": "node scripts/acceptance/p04-accept.ts",
    "accept:p05": "node scripts/acceptance/p05-accept.ts",
    "accept:p06": "node scripts/acceptance/p06-accept.ts",
    "accept:p07": "node scripts/acceptance/p07-accept.ts",
    "accept:p08:live": "node scripts/acceptance/p08-todo-live.ts",
    "accept:p04:live": "node scripts/acceptance/p04-live.ts",
    "accept:p03:clean-replay": "node scripts/acceptance/p03-clean-replay.ts"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-codemode": "1.0.4",
    "@earendil-works/pi-mcp": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/node": "22.20.4",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-codemode": "1.0.4",
    "@earendil-works/pi-mcp": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4"
  }
}
