{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "shiploop-core": ["./packages/core/src/index.ts"],
      "shiploop-core/protocol": ["./packages/core/src/protocol.ts"],
      "shiploop-core/testing": ["./packages/core/src/adapters/testing.ts"],
      "shiploop-core/assembly": ["./packages/core/src/adapters/composition.ts"],
      "shiploop-host": ["./packages/host/src/index.ts"]
    }
  },
  "include": [
    "vitest.config.ts",
    "test/**/*.ts",
    "examples/**/*.ts",
    "scripts/**/*.ts",
    "packages/core/src/**/*.ts",
    "packages/host/src/**/*.ts",
    "packages/cli/src/**/*.ts"
  ]
}
