{
  "name": "shiploop-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ShipLoop CLI (private workspace package; not published)",
  "engines": {
    "node": "^22.19.0 || ^24.14.1 || ^26.7.0",
    "npm": ">=10.9.3 <12"
  },
  "os": [
    "darwin"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "shiploop": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "dependencies": {
    "shiploop-host": "0.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json"
  }
}
