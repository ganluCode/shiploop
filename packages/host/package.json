{
  "name": "shiploop-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ShipLoop Host (private workspace package; not published)",
  "engines": {
    "node": "22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "shiploop-core": "0.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-host-lock.ts && tsc -b tsconfig.json"
  }
}
